# SQL-GPT — Environment Variables
# Author: Rayen Lassoued | github.com/Hamilas
#
# Copy this file to .env and fill in ONE LLM API key:
#   cp .env.example .env
#
# Priority: Groq → Anthropic → Google → OpenAI
# Leave all blank to run in demo mode (SQL engine active, LLM mocked)

# ─────────────────────────────────────────────────────────────────────────────
# LLM PROVIDER (choose one — only one required)
# ─────────────────────────────────────────────────────────────────────────────

# Option 1: Groq (recommended — free tier, fastest inference)
# Get key at: https://console.groq.com/
GROQ_API_KEY=your_groq_key_here

# Option 2: Anthropic Claude (highest accuracy)
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here

# Option 3: Google Gemini (free tier available)
# Get key at: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_key_here

# Option 4: OpenAI GPT-4o Mini
# Get key at: https://platform.openai.com/
OPENAI_API_KEY=your_openai_key_here

# ─────────────────────────────────────────────────────────────────────────────
# TELEMETRY (privacy settings)
# ─────────────────────────────────────────────────────────────────────────────

ANONYMIZED_TELEMETRY=False
POSTHOG_DISABLED=true
CHROMA_TELEMETRY=False
